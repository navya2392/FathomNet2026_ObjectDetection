# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; `.env.example` is committed as a template.
# DO NOT put real credentials in this file.

# ---- Kaggle ----
# Bearer-style API token from https://www.kaggle.com/settings (Create New Token).
# NOTE: For day-to-day use, prefer setting this as a persistent Windows User env var:
#   [Environment]::SetEnvironmentVariable("KAGGLE_API_TOKEN", "KGAT_...", "User")
# This .env entry is a fallback for scripts that load via python-dotenv.
KAGGLE_API_TOKEN=<your_kgat_token>

# ---- Weights & Biases ----
# From https://wandb.ai/authorize
# Either set as Windows User env var (preferred):
#   [Environment]::SetEnvironmentVariable("WANDB_API_KEY", "your_key", "User")
# OR fill in here as a fallback:
WANDB_API_KEY=<your_wandb_api_key>
WANDB_PROJECT=fathomnet-2026
WANDB_ENTITY=navya2392-usc

# ---- Hugging Face ----
# Only needed for gated models; BioClip2 is public so this is optional.
# Token from https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=<optional_hf_read_token>

# ---- RunPod (Phase 1+) ----
# SSH connection string for the active pod, e.g.: root@1.2.3.4 -p 12345
RUNPOD_SSH=
RUNPOD_POD_ID=

# ---- Project paths ----
# Override defaults in src/config.py if you keep data outside the repo.
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
